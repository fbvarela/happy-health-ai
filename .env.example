# ── Core ──────────────────────────────────────────────────────────
# Postgres (Neon). Production + preview scopes on Vercel; local for dev.
DATABASE_URL=postgresql://user:password@neon-host/dbname

# App URL used in magic links and redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# iron-session secret — min 32 chars, keep private
SESSION_SECRET=

# ── Email (magic links) ───────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@happyfactory.app

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# App-specific prices (create product "Happy Health AI Premium")
STRIPE_HEALTH_MONTHLY=price_xxx
STRIPE_HEALTH_ANNUAL=price_xxx

# Bundle prices — same IDs in every Happy Factory app
STRIPE_BUNDLE_MONTHLY=price_xxx
STRIPE_BUNDLE_ANNUAL=price_xxx

# ── AI chat ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Storage (pending SPEC §9.5: Cloudflare R2 vs Vercel Blob) ────
# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_DOMAIN=

# ── Google Calendar (pending SPEC §9.6) ──────────────────────────
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google-calendar/callback

# ── Dev helpers ───────────────────────────────────────────────────
# When true, /login shows a one-click test login (uses first ADMIN_EMAIL)
NEXT_PUBLIC_ENABLE_TEST_LOGIN=false

# Dev-only: log magic links to console when RESEND_API_KEY is absent

# ── Core ──────────────────────────────────────────────────────────
# Postgres (Neon). Production + preview scopes on Vercel; local for dev.
DATABASE_URL=postgresql://user:password@neon-host/dbname

# App URL used in OAuth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# iron-session secret — min 32 chars, keep private
SESSION_SECRET=

# ── Auth: Google OAuth + admin approval (D1) ─────────────────────
# Google Cloud OAuth client (consent screen: external, test users fine for dev)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
# Defaults to {NEXT_PUBLIC_APP_URL}/api/auth/callback if unset
GOOGLE_REDIRECT_URI=

# Comma-separated emails that can approve new caregivers (access /admin/approvals)
ADMIN_EMAILS=

# Google Calendar (Phase 4, D4) — defaults to {NEXT_PUBLIC_APP_URL}/api/calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=

# ── AI chat (Phase 5 — D8: Cohere or Groq, free tier) ────────────
COHERE_API_KEY=xxx
GROQ_API_KEY=xxx

# ── Storage (Phase 6 — D2: Cloudflare R2 private bucket, garden pattern) ──
# Cloudflare R2 (S3-compatible). Health data is private — signed URLs only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=happyfactory-private
